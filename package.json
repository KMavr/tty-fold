{
  "name": "tty-fold",
  "version": "0.1.0",
  "description": "Turn raw terminal output into the text a human would have seen on screen",
  "keywords": [
    "ansi",
    "terminal",
    "tty",
    "escape-codes",
    "strip-ansi",
    "spinner",
    "progress",
    "logs",
    "ci",
    "llm"
  ],
  "author": "Konstantinos Mavrikas <mavrikas.konstantinos@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KMavr/tty-fold.git"
  },
  "bugs": {
    "url": "https://github.com/KMavr/tty-fold/issues"
  },
  "homepage": "https://github.com/KMavr/tty-fold#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "node -e \"if (process.env.CI) process.exit(0)\" && husky",
    "prepack": "pnpm build && pnpm lint && pnpm typecheck && pnpm test --run",
    "bench": "pnpm build && node bench/tokens.js && node bench/speed.js"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gpt-tokenizer": "^4.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
